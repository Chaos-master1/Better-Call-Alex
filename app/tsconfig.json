{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "cli.ts",
    "lib/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "app/**",
    "components/**",
    "next.config.mjs",
    "next-env.d.ts",
    ".next/**"
  ]
}
